# Скопируй в backend/.env и подставь реальные значения

# ID Google-таблицы (из URL после /spreadsheets/d/...)
SPREADSHEET_ID=

# Секрет для подписи JWT — обязательно поменяй в проде.
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change-me-please

# Путь к creds Google Service Account (в docker заменяется на /app/credentials.json)
# В dev-режиме оставь как есть, файл должен лежать в backend/credentials.json
GOOGLE_CREDENTIALS_PATH=credentials.json

# Redis (только для docker-compose; в dev по умолчанию localhost:6379)
# REDIS_HOST=redis
# REDIS_PORT=6379
